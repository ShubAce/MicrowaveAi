# Google AI Studio keys: https://aistudio.google.com/apikey
# Free quotas belong to a Google Cloud project, not to a key: create each key in its own project, or
# the keys share one quota. They are tried in order (GEMINI_API_KEY1, GEMINI_API_KEY2, ...); a key that
# is rate limited or has used up a model's quota for the day goes to the back of the line for that model
# until it is good again (when every key is used up, each request still asks each of them once; Google
# answers 429 straight away). A single GEMINI_API_KEY works too.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=

# Sarvam AI keys (the Hindi voice and speech-to-text): https://dashboard.sarvam.ai
# The second is used when the first runs out of credits, is rate limited or isn't accepted. If neither
# works (or Sarvam doesn't answer), Gemini listens and speaks instead. A single SARVAMAI (or
# SARVAM_API_KEY) works too.
SARVAMAI_1=
SARVAMAI_2=

# Secret for the family-only link. Open https://<your-app>/?key=<FAMILY_KEY> once on her phone;
# it is remembered for a year. Leave empty when running locally to keep the app open.
FAMILY_KEY=

# Optional: Gemini models to try, in order (answers, speech-to-text fallback, text-to-speech fallback).
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# GEMINI_STT_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview
# GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Sulafat
