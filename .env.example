# Google AI Studio key: https://aistudio.google.com/apikey
# The free tier allows about 20 questions a day per model; turn on billing for no daily cap.
GEMINI_API_KEY=

# Sarvam AI key: https://dashboard.sarvam.ai  (SARVAM_API_KEY works too)
SARVAMAI=

# Secret for the family-only link. Open https://<your-app>/?key=<FAMILY_KEY> once on her phone;
# it is remembered for a year. Leave empty when running locally to keep the app open.
FAMILY_KEY=

# Optional: Gemini models to try, in order.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
